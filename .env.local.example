# Admin login
ADMIN_PASSWORD=ganti_dengan_password_kuat
ADMIN_SESSION_SECRET=acak_minimal_32_karakter

# Supabase PostgreSQL + Realtime
# Jalankan supabase/schema.sql di Supabase SQL Editor terlebih dahulu.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Dipakai browser untuk subscription Realtime; jangan gunakan secret key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_browser_key
