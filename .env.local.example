# Password untuk login ke panel admin (/admin/login)
ADMIN_PASSWORD=ganti_dengan_password_anda_yang_kuat

# Kunci sesi keamanan untuk enkripsi token login
ADMIN_SESSION_SECRET=ganti_dengan_acak_panjang_minimal_32_karakter

# Supabase: jalankan supabase/schema.sql di SQL Editor terlebih dahulu.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Publishable key digunakan browser untuk Supabase Realtime (aman untuk frontend).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_browser_key
