# Password untuk login ke panel admin (/admin/login)
ADMIN_PASSWORD=ganti_dengan_password_anda_yang_kuat

# Kunci sesi keamanan untuk enkripsi token login
ADMIN_SESSION_SECRET=ganti_dengan_acak_panjang_minimal_32_karakter

# ==============================================================================
# CLOUD DATABASE (Wajib diisi saat deploy ke Vercel/Netlify agar status kamar persisten)
# Dapatkan gratis di https://upstash.com (Free tier 10.000 request/hari, tanpa kartu kredit)
# Buat database Redis -> REST API -> salin URL REST API dan token dengan akses tulis.
# Jangan gunakan URL halaman console (console.upstash.com/...) atau read-only token.
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
