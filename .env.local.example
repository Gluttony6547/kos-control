# Password untuk login ke panel admin (/admin/login)
ADMIN_PASSWORD=ganti_dengan_password_anda_yang_kuat

# Kunci sesi keamanan untuk enkripsi token login
ADMIN_SESSION_SECRET=ganti_dengan_acak_panjang_minimal_32_karakter

# ==============================================================================
# SUPABASE STORAGE (Wajib diisi saat deploy agar status kamar persisten)
# SUPABASE_URL adalah URL project, contoh: https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY hanya dipakai di server, jangan expose ke browser.
# Bucket akan dibuat otomatis dengan nama "room-data" jika belum ada.
# ==============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=room-data
