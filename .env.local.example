# Supabase: jalankan supabase/schema.sql di SQL Editor terlebih dahulu.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key

# Publishable key digunakan browser untuk Supabase Realtime (aman untuk frontend).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_browser_key
